<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DialogStyle" parent="@android:style/Theme.Dialog">
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>
    <style name="SearchTextViewTheme" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
    </style>
    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/dark_grey</item>
        <item name="colorControlActivated">@color/yellow</item>
    </style>

    <style name="DialogAnimationExclusive">
        <item name="android:windowBackground">@drawable/popup_background</item>
        <item name="android:windowEnterAnimation">@anim/slide_up_anim_dialog</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="MyDatePicker" parent="@android:style/Widget.DeviceDefault.DatePicker">
        <item name="colorControlNormal">@color/green</item>
        <item name="colorControlActivated">@color/green</item>
    </style>

    <style name="customTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">@color/green</item>
        <item name="tabIndicatorHeight">@dimen/margin_padding_4dp</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_15sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="tabBackground">?attr/selectableItemBackground</item>
        <item name="tabSelectedTextColor">@color/green</item>
    </style>


    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/zoom_in</item>
        <item name="android:windowExitAnimation">@anim/zoom_out</item>
        <item name="android:windowBackground">@drawable/popup_background</item>
    </style>

    <style name="DialogAnimation23">
        <item name="android:windowEnterAnimation">@anim/zoom_in</item>
        <item name="android:windowExitAnimation">@anim/zoom_out</item>
        <item name="android:windowBackground">@drawable/popup_background</item>
    </style>

    <style name="lightStyle">
        <item name="fontFamily">@font/inter_light</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="lightStyleLight">
        <item name="fontFamily">@font/inter_light</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="mediumStyle">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="mediumStyleLight">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="boldStyle">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="boldStyleLight">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="smallRadiusImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>




</resources>