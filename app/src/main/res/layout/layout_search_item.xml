<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:id="@+id/mainLocationItem"
    android:layout_marginStart="@dimen/margin_padding_4dp"
    android:layout_marginEnd="@dimen/margin_padding_4dp"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/locationClick"
        android:layout_marginTop="@dimen/margin_padding_8dp"
        android:background="@drawable/bg_grey_rounded"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ташкент область"
            android:id="@+id/search_item_text"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/black"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="@dimen/margin_padding_12dp"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:src="@drawable/ic_arrow_right"
            android:layout_gravity="end|center_vertical"/>
    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>