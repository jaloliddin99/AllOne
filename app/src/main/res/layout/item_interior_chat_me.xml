<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:background="@drawable/interior_chat_me"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_padding_16dp"
        android:layout_marginBottom="@dimen/margin_padding_8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_text_me"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="Хэй!"
            android:layout_marginVertical="@dimen/margin_padding_12dp"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_marginEnd="@dimen/text_size_12sp"
            android:textColor="@color/white"
            android:textSize="16sp" />


    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView

        android:id="@+id/txt_time_me"
        android:text="23:46"
        android:layout_gravity="bottom|end"
        android:textSize="11sp"
        android:paddingEnd="@dimen/margin_padding_12dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="@dimen/margin_padding_12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green"
        tools:ignore="RtlSymmetry" />
</LinearLayout>