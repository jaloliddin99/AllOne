<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:background="@drawable/interior_chat_me"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_padding_16"
        android:layout_marginStart="@dimen/margin_padding_60dp"
        android:layout_marginBottom="@dimen/margin_padding_8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_text_me"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/lorem_ipsum"
            android:layout_marginVertical="@dimen/margin_padding_12dp"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_marginEnd="@dimen/text_size_12sp"
            android:visibility="visible"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="200dp"
            android:visibility="gone"
            android:id="@+id/card"

            android:layout_height="300dp"
            android:layout_marginVertical="@dimen/margin_padding_12dp"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_marginEnd="@dimen/text_size_12sp"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:cardElevation="@dimen/dimens_0dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/imageSend"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <TextView

        android:id="@+id/txt_time_me"
        android:text="23:46"
        android:layout_gravity="bottom|end"
        android:textSize="11sp"
        android:paddingEnd="@dimen/margin_padding_12dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="@dimen/margin_padding_12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green"
        tools:ignore="RtlSymmetry" />
</LinearLayout>