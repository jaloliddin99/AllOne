<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="@dimen/dimens_0dp"
    android:layout_marginTop="@dimen/margin_padding_12dp"
    app:cardCornerRadius="@dimen/margin_padding_12dp"
    app:rippleColor="@android:color/transparent"
    android:layout_marginEnd="@dimen/margin_padding_8dp"
    android:backgroundTint="@color/grey"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:id="@+id/poster"
                app:layout_constraintTop_toTopOf="parent"
                android:scaleType="centerCrop"/>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_drawable"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingVertical="@dimen/dimen_2dp"
                android:paddingHorizontal="5dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/margin_padding_16"
                android:layout_marginBottom="@dimen/margin_padding_8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/rating"
                    android:textSize="@dimen/text_size_12sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="5dp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/review_count"
                    android:layout_marginStart="@dimen/dimen_2dp"
                    android:textSize="@dimen/text_size_12sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/black"
                    android:drawablePadding="5dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>




        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_16"
            android:id="@+id/name"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:text="Shox International  Hospital"
            android:fontFamily="@font/inter_semibold"
            android:textSize="@dimen/text_size_15sp"
            android:textColor="@color/black"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Многопрофильная клиника"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:paddingVertical="@dimen/dimen_2dp"
            android:paddingHorizontal="@dimen/margin_padding_4dp"
            android:id="@+id/type"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_medium"
            android:backgroundTint="@color/green"
            android:textColor="@color/white"
            android:background="@drawable/drawable_4dp_corner"/>


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:text="г. Ташкент, Узбекистан"
            android:maxLines="1"
            android:ellipsize="end"
            android:drawableStart="@drawable/ic_location_sma"
            android:drawablePadding="6dp"
            android:layout_marginStart="@dimen/margin_padding_16"
            android:id="@+id/addr"
            android:textColor="#666F75"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_regular"/>


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_10dp"
            android:layout_marginBottom="@dimen/margin_padding_16"
            android:text="г. Ташкент, Узбекистан"
            android:id="@+id/work_time"
            android:drawableStart="@drawable/ic_time_left_gray"
            android:drawablePadding="6dp"
            android:layout_marginStart="@dimen/margin_padding_16"
            android:textColor="#666F75"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_regular"/>


    </androidx.appcompat.widget.LinearLayoutCompat>


</com.google.android.material.card.MaterialCardView>