<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.profile.main.ProfileFragment">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="@dimen/margin_padding_4dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drawer_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tint="@color/black"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_padding_16"
            android:src="@drawable/ic_drawer_icon" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter_medium"
            android:text="@string/profile"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_padding_4dp"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_bell" />

    </RelativeLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/item_height_56dp"
        android:scrollbars="none"
        android:visibility="visible">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/user_profile"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:layout_marginTop="40dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/changeImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:elevation="@dimen/margin_padding_8dp"
                        android:layout_height="wrap_content">
                        <include layout="@layout/loader_lottie"
                            android:id="@+id/loader"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:layout_height="50dp"
                            android:layout_width="50dp" />
                    </FrameLayout>


                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imageProfile"
                        android:src="@drawable/ic_profile_user"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:src="@drawable/ic_profile_image_edit" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/user_profile"
                android:layout_marginHorizontal="@dimen/margin_padding_16"
                android:layout_marginTop="@dimen/margin_padding_16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginHorizontal="50dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/user_name"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_user_phone_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/profile_user_phone_number"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/text_size_15sp" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bonus_card"
                    android:layout_width="match_parent"
                    android:layout_height="95dp"
                    app:rippleColor="@android:color/transparent"
                    android:layout_marginTop="30dp"

                    android:backgroundTint="@color/green"
                    app:cardCornerRadius="@dimen/margin_padding_12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.legacy.widget.Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="6"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="32dp"
                                android:background="@drawable/ic_wave_two" />

                            <FrameLayout

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/ic_wave_one" />
                        </RelativeLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_padding_16dp"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginEnd="@dimen/margin_padding_16dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/bonus_ball"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_18sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="@dimen/text_size_15sp"
                                android:id="@+id/userId"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_padding_16dp"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginEnd="@dimen/margin_padding_16dp"
                            android:layout_marginBottom="@dimen/margin_padding_16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="3"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/balanceText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_bold"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_24sp"
                                    android:textStyle="bold" />

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/margin_padding_4dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:text="@string/summa1"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_18sp" />


                            </LinearLayout>


                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:layout_weight="1"
                                android:drawableEnd="@drawable/ic_arrow_right_white"
                                android:drawablePadding="@dimen/margin_padding_12dp"
                                android:text="@string/go_to"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_13sp"
                                tools:ignore="RtlCompat" />
                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <LinearLayout

                    android:id="@+id/changeData"
                    android:layout_marginTop="@dimen/margin_padding_16"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_height="@dimen/item_height_56dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/icon_size_20dp"
                        android:layout_height="@dimen/icon_size_20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_change_user_detail"
                        app:tint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginVertical="9dp"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/change_user_info"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#C8C8C8" />

                <LinearLayout
                    android:id="@+id/changePhoneNum"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_height="@dimen/item_height_56dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/icon_size_20dp"
                        android:layout_height="@dimen/icon_size_20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/change_phone_num"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                        <TextView
                            android:id="@+id/phoneNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_padding_4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/hint_color"
                            android:textSize="@dimen/text_size_13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#C8C8C8" />

                <LinearLayout
                    android:id="@+id/myCards"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_height_56dp"

                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/icon_size_20dp"
                        android:layout_height="@dimen/icon_size_20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_parment_card_add" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/addCard"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                        <TextView
                            android:id="@+id/cardNumber"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_padding_4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/hint_color"
                            android:textSize="@dimen/text_size_13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#C8C8C8" />

                <LinearLayout
                    android:id="@+id/change_language"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_height="@dimen/item_height_56dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/margin_padding_24dp"
                        android:layout_height="@dimen/margin_padding_24dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_language"
                        app:tint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginVertical="9dp"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/language"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#C8C8C8" />

                <LinearLayout

                    android:id="@+id/aboutAppBtn"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_height="@dimen/item_height_56dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/icon_size_20dp"
                        android:layout_height="@dimen/icon_size_20dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_attention"
                        app:tint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginVertical="9dp"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"

                            android:text="@string/about_app"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#C8C8C8" />

                <LinearLayout
                    android:id="@+id/technicalSupport"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_height="@dimen/item_height_56dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/icon_size_20dp"
                        android:layout_height="@dimen/icon_size_20dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_technical_support"
                        app:tint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginVertical="9dp"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"

                            android:text="@string/tech_support"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#C8C8C8" />

                <LinearLayout
                    android:id="@+id/logOut"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/margin_padding_8dp"
                    android:layout_height="@dimen/item_height_56dp"
                    android:layout_marginBottom="70dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/margin_padding_24dp"
                        android:layout_height="@dimen/margin_padding_24dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_exit"
                        app:tint="@color/green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginVertical="9dp"
                        android:layout_marginStart="@dimen/margin_padding_12dp"
                        android:layout_weight="8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"

                            android:text="@string/log_out_profile"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_17sp" />


                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>


            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>