<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/margin_padding_8dp"
    android:background="@drawable/background_white_corner_12"
    android:backgroundTint="#F6F6F6"
    android:layout_marginBottom="@dimen/margin_padding_16"
    android:layout_marginHorizontal="@dimen/margin_padding_16"
    android:layout_height="wrap_content">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/card"
        app:cardCornerRadius="@dimen/margin_padding_12dp"
        app:cardElevation="@dimen/dimens_0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/poster"
            android:scaleType="centerCrop"
            android:src="@drawable/two_girls" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_12sp"
            android:textColor="@color/black"
            android:id="@+id/travel_agency"
            android:fontFamily="@font/inter_regular"
            android:background="@drawable/chip_drawable"
            android:paddingHorizontal="@dimen/dimens_6dp"
            android:paddingVertical="3dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/dimens_10dp"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:text="Azon travel"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_bold"
            android:id="@+id/rating"
            android:background="@drawable/chip_drawable"
            android:drawableStart="@drawable/ic_star"
            android:paddingHorizontal="@dimen/dimens_6dp"
            android:drawablePadding="@dimen/dimens_6dp"
            android:paddingVertical="3dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="@dimen/dimens_10dp"
            android:layout_marginEnd="@dimen/margin_padding_12dp"
            android:text="4.8"/>




    </com.google.android.material.card.MaterialCardView>


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        app:layout_constraintTop_toBottomOf="@+id/card"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/lorem_ipsum"
        android:id="@+id/name"
        android:lineSpacingExtra="@dimen/margin_padding_4dp"

        android:textColor="@color/black"
        android:textSize="@dimen/text_size_18sp"
        android:fontFamily="@font/inter_bold"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:id="@+id/constraintLayout"
        app:layout_constraintTop_toBottomOf="@id/name"
        android:layout_marginTop="@dimen/dimens_10dp"
        android:layout_height="wrap_content">


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="@dimen/dimens_0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_13sp"
            android:fontFamily="@font/inter_medium"
            android:drawableStart="@drawable/ic_location_sma"
            app:layout_constraintEnd_toStartOf="@id/price_from"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/location"
            android:text="Самарканд, Узбекистан"

            android:drawablePadding="@dimen/dimens_6dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_15sp"
            android:id="@+id/price_from"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="#119E46"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="$3"
            android:drawablePadding="@dimen/dimens_6dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>