<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_corner_12"
    android:backgroundTint="#F6F6F6"
    android:layout_marginBottom="9dp"
    android:padding="@dimen/margin_padding_8dp"
    android:layout_height="wrap_content">

   <com.google.android.material.card.MaterialCardView
       android:layout_width="80dp"
       android:layout_height="80dp"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toTopOf="parent"
       android:id="@+id/card"
       app:layout_constraintBottom_toBottomOf="parent"
       app:cardCornerRadius="@dimen/margin_padding_12dp"
       app:cardElevation="@dimen/dimens_0dp">

       <androidx.appcompat.widget.AppCompatImageView
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           android:scaleType="centerCrop"
           android:id="@+id/poster"/>
   </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="@dimen/dimens_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card"
        app:layout_constraintEnd_toStartOf="@id/arrow"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Номер люкс категории Presidential"
            android:textSize="@dimen/text_size_15sp"
            android:id="@+id/name"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/black"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ном"
            android:id="@+id/price"
            android:background="@drawable/drawable_4dp_corner"
            android:textSize="@dimen/text_size_12sp"
            android:backgroundTint="@color/dark_green"
            android:includeFontPadding="false"
            android:layout_marginTop="@dimen/dimens_10dp"
            android:paddingHorizontal="@dimen/margin_padding_4dp"
            android:paddingVertical="@dimen/dimen_2dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/white"/>



    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="@dimen/margin_padding_8dp"/>




</androidx.constraintlayout.widget.ConstraintLayout>