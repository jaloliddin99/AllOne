<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_not_clicked_8dp"
    android:layout_width="wrap_content"
    android:id="@+id/mainBg"
    android:layout_marginStart="@dimen/margin_padding_8dp"
    android:paddingVertical="@dimen/margin_padding_4dp"
    android:paddingHorizontal="@dimen/margin_padding_8dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageCar"
        android:layout_height="34dp"
        android:layout_width="wrap_content"
        android:scaleType="centerInside"
        android:src="@drawable/ic_car1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:fontFamily="@font/inter_medium"
        android:id="@+id/type"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_4dp"
        android:layout_width="wrap_content"
        android:text="Аккумулятор"
        android:textColor="#435162"
        android:textSize="@dimen/text_size_12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageCar" />

    <androidx.appcompat.widget.AppCompatTextView
        android:fontFamily="@font/inter_medium"
        android:id="@+id/price"
        android:drawablePadding="@dimen/margin_padding_4dp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:drawableStart="@drawable/ic_flash_light_icon"
        android:text="24000 сум"

        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/type" />


</androidx.constraintlayout.widget.ConstraintLayout>
