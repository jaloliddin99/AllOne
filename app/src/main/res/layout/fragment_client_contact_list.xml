<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:context=".fragments.taxiCity.contact.FragmentContact"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="@dimen/margin_padding_4dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backToHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter_medium"
            android:text="@string/order_for_your_friend"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:layout_marginTop="@dimen/margin_padding_16"
        android:layout_height="@dimen/dimen_48dp"
        android:id="@+id/search"
        android:background="@drawable/bg_grey_rounded"
        android:layout_marginHorizontal="@dimen/margin_padding_16">

        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/searchText"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/margin_padding_12dp"
            android:background="@null"
            android:imeOptions="actionDone"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:hint="Jamshid"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="@dimen/text_size_13sp" />

    </RelativeLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_0dp"
        app:layout_constraintTop_toBottomOf="@id/search"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/select">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_0dp"
            android:paddingBottom="@dimen/margin_padding_24dp"
            android:clipToPadding="false"
            android:paddingTop="@dimen/margin_padding_12dp"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:id="@+id/recyclerView"/>
    </androidx.core.widget.NestedScrollView>



    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height_56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="@dimen/margin_padding_16"
        app:cornerRadius="@dimen/margin_padding_12dp"
        android:insetTop="@dimen/dimens_0dp"
        android:insetBottom="0dp"
        android:alpha="0.4"
        android:layout_marginBottom="@dimen/margin_padding_24dp"
        android:id="@+id/select"
        android:text="@string/select"
        android:textAllCaps="false"
        android:textSize="@dimen/text_size_15sp"
        android:fontFamily="@font/inter_semibold"/>




</androidx.constraintlayout.widget.ConstraintLayout>