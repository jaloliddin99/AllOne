<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_corner_12"
    android:padding="@dimen/margin_padding_8dp"
    android:layout_marginBottom="9dp"
    android:backgroundTint="#F6F6F6"
    android:layout_height="wrap_content">



    <com.google.android.material.card.MaterialCardView
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="@dimen/margin_padding_8dp"
        app:cardElevation="@dimen/dimens_0dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/poster"
            android:scaleType="centerCrop"/>

    </com.google.android.material.card.MaterialCardView>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_padding_12dp"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_marginEnd="@dimen/margin_padding_16"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="@dimen/dimens_0dp"
                app:layout_constraintEnd_toStartOf="@+id/rating"
                android:maxLines="1"
                android:id="@+id/name"
                android:ellipsize="end"
                android:layout_height="wrap_content"
                android:text="Shox International  Hospital"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_15sp"
                android:fontFamily="@font/inter_semibold"/>

            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:drawablePadding="@dimen/margin_padding_4dp"
                android:layout_height="wrap_content"
                android:text="4.8"
                android:drawableStart="@drawable/ic_star"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_12sp"
                android:fontFamily="@font/inter_semibold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Многопрофильная клиника"
            android:layout_marginTop="4dp"
            android:paddingVertical="@dimen/dimen_2dp"
            android:id="@+id/type"
            android:paddingHorizontal="@dimen/margin_padding_4dp"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_medium"
            android:backgroundTint="@color/dark_green"
            android:textColor="@color/white"
            android:background="@drawable/drawable_4dp_corner"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="г. Ташкент, Узбекистан "
            android:drawableStart="@drawable/ic_location_sma"
            android:drawablePadding="6dp"
            android:id="@+id/addr"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:textColor="#666F75"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_regular"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:layout_marginBottom="@dimen/margin_padding_16"
            android:maxLines="1"
            android:ellipsize="end"
            android:id="@+id/work_time"
            android:text="г. Ташкент, Узбекистан"
            android:drawableStart="@drawable/ic_time_left_gray"
            android:drawablePadding="6dp"
            android:textColor="#666F75"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_regular"/>


    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>