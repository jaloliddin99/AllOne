<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:context=".fragments.charity.PaymentCard.FragmentPaymentCardSelection"
    android:layout_height="match_parent">

    <RelativeLayout
        android:elevation="@dimen/margin_padding_4dp"
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/backToHome"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_centerVertical="true"
            android:focusable="true" />

    </RelativeLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/item_height_56dp"
        android:layout_height="@dimen/item_height_56dp"
        android:layout_gravity="center"
        app:cardCornerRadius="@dimen/margin_padding_12dp"
        android:layout_marginTop="@dimen/margin_padding_24dp"
        app:cardElevation="0dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/image"/>
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AJR Loyihasi"
        android:id="@+id/title"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        android:layout_gravity="center"
        android:textSize="@dimen/text_size_13sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/black"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select"
        android:layout_marginTop="@dimen/margin_padding_24dp"
        android:layout_marginStart="@dimen/margin_padding_16"
        android:textSize="@dimen/text_size_13sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/black"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height_56dp"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        android:background="@drawable/bg_grey_rounded"
        android:layout_marginHorizontal="@dimen/margin_padding_16">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_padding_16"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="8600 0304 0504 9696"
                android:textColor="@color/black"
                android:id="@+id/card_number"
                android:textSize="@dimen/text_size_15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/cardholder_name"
                android:fontFamily="@font/inter_regular"
                android:text="Sardor Rahimxon"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_13sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_padding_16"
            android:id="@+id/type"
            android:layout_toStartOf="@id/topUp"
            android:src="@drawable/humo" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/topUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="11dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/up"
                android:layout_width="@dimen/margin_padding_24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="5dp"
                android:src="@drawable/ic_arrow_top"
                app:tint="#333333" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/down"
                android:layout_width="@dimen/margin_padding_24dp"
                android:layout_height="@dimen/margin_padding_24dp"
                android:background="?attr/selectableItemBackground"
                app:tint="#333333"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="5dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_top" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/donationAmount"
        android:layout_marginTop="@dimen/margin_padding_36dp"
        android:layout_marginStart="@dimen/margin_padding_16"
        android:textSize="@dimen/text_size_13sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/black"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height_56dp"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        android:background="@drawable/bg_grey_rounded"
        android:layout_marginHorizontal="@dimen/margin_padding_16">

        <EditText
            android:id="@+id/charityAmount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/enter_summa"
            android:inputType="number"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/margin_padding_16" />


    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_16"
        android:text="@string/min_100_sum"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_13sp"
        android:layout_marginTop="@dimen/margin_padding_4dp"/>

    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/signIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:elevation="0dp"
        android:layout_marginStart="@dimen/margin_padding_16"
        android:layout_marginEnd="@dimen/margin_padding_16"
        android:layout_marginBottom="@dimen/margin_padding_24dp"
        android:background="@drawable/background_white_corner_12"
        android:backgroundTint="@color/dark_grey"
        android:padding="@dimen/margin_padding_16dp"
        android:text="@string/nect"
        android:textAppearance="@style/boldStyleLight"
        android:textSize="@dimen/text_size_18sp" />

</androidx.appcompat.widget.LinearLayoutCompat>