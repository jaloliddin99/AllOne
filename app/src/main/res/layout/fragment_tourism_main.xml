<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:context=".fragments.tourism.mainTourism.FragmentTourismMain"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:elevation="@dimen/margin_padding_4dp"
            android:layout_width="match_parent"
            android:id="@+id/toolbar"
            android:layout_height="?attr/actionBarSize">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/backToHome"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:padding="@dimen/margin_padding_12dp"
                android:src="@drawable/ic_arrow_left"
                android:layout_marginStart="@dimen/margin_padding_12dp"
                android:layout_centerVertical="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tourism"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_20sp"
                android:fontFamily="@font/inter_medium"
                android:layout_centerInParent="true"/>

        </RelativeLayout>


        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:background="@drawable/bg_grey_rounded"
            app:iconifiedByDefault="false"
            app:queryBackground="@null"
            app:queryHint="Поиск клиник и врачей" />


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <androidx.viewpager.widget.ViewPager
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:paddingHorizontal="@dimen/margin_padding_16"
                    android:clipToPadding="false"
                    android:layout_marginTop="@dimen/margin_padding_16"
                    android:id="@+id/viewPager"/>
                <me.relex.circleindicator.CircleIndicator
                    android:id="@+id/indicator"
                    app:ci_drawable_unselected="@drawable/image_unselected"
                    app:ci_drawable="@drawable/image_selected"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>



                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_direction"
                    android:textSize="@dimen/text_size_15sp"
                    android:layout_marginHorizontal="@dimen/margin_padding_16"
                    android:textColor="@color/black"
                    android:fontFamily="@font/inter_bold"/>

               <androidx.appcompat.widget.LinearLayoutCompat
                   android:layout_marginTop="@dimen/margin_padding_12dp"
                   android:layout_width="match_parent"
                   android:layout_marginHorizontal="@dimen/margin_padding_16"
                   android:layout_height="wrap_content">
                   <androidx.constraintlayout.widget.ConstraintLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:id="@+id/view1"
                       android:layout_marginEnd="@dimen/margin_padding_4dp"
                       android:backgroundTint="#F6F6F6"
                       android:background="@drawable/background_grey"
                       android:layout_height="80dp">
                       <androidx.appcompat.widget.AppCompatTextView
                           android:layout_width="@dimen/dimens_0dp"
                           android:layout_height="wrap_content"
                           android:text="@string/tour_uzb"
                           android:elevation="@dimen/margin_padding_8dp"
                           android:layout_marginEnd="@dimen/margin_padding_8dp"
                           android:layout_marginTop="@dimen/margin_padding_12dp"
                           android:layout_marginStart="@dimen/margin_padding_12dp"
                           app:layout_constraintTop_toTopOf="parent"
                           app:layout_constraintStart_toStartOf="parent"
                           android:textSize="@dimen/text_size_13sp"
                           app:layout_constraintEnd_toEndOf="parent"
                           android:textColor="@color/black"
                           android:fontFamily="@font/inter_semibold"/>
                       <androidx.appcompat.widget.AppCompatImageView
                           android:id="@+id/image"
                           android:layout_width="wrap_content"
                           app:layout_constraintEnd_toEndOf="parent"
                           app:layout_constraintBottom_toBottomOf="parent"
                           android:layout_height="wrap_content"
                           android:layout_alignParentEnd="true"
                           android:layout_marginTop="@dimen/margin_padding_12dp"
                           android:src="@drawable/ic_tour_uzb" />

                   </androidx.constraintlayout.widget.ConstraintLayout>
                   <androidx.constraintlayout.widget.ConstraintLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:id="@+id/view2"
                       android:layout_marginStart="@dimen/margin_padding_4dp"
                       android:backgroundTint="#F6F6F6"
                       android:background="@drawable/background_grey"
                       android:layout_height="80dp">
                       <androidx.appcompat.widget.AppCompatTextView
                           android:layout_width="@dimen/dimens_0dp"
                           android:layout_height="wrap_content"
                           android:text="@string/tour_world"
                           android:layout_marginEnd="@dimen/margin_padding_8dp"
                           app:layout_constraintEnd_toEndOf="parent"
                           android:layout_marginTop="@dimen/margin_padding_12dp"
                           android:layout_marginStart="@dimen/margin_padding_12dp"
                           app:layout_constraintTop_toTopOf="parent"
                           app:layout_constraintStart_toStartOf="parent"
                           android:id="@+id/clinic"
                           android:elevation="@dimen/margin_padding_8dp"
                           android:textSize="@dimen/text_size_13sp"
                           android:textColor="@color/black"
                           android:fontFamily="@font/inter_semibold"/>

                       <androidx.appcompat.widget.AppCompatImageView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_below="@id/clinic"
                           android:layout_alignParentEnd="true"
                           android:scaleType="centerCrop"
                           android:src="@drawable/tour_worldd"
                           app:layout_constraintBottom_toBottomOf="parent"
                           app:layout_constraintEnd_toEndOf="parent" />

                   </androidx.constraintlayout.widget.ConstraintLayout>
               </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_marginTop="@dimen/margin_padding_8dp"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/margin_padding_16"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:id="@+id/view3"
                        android:layout_marginEnd="@dimen/margin_padding_4dp"
                        android:backgroundTint="#F6F6F6"
                        android:background="@drawable/background_grey"
                        android:layout_height="80dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dimens_0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/tour_firms"
                            android:elevation="@dimen/margin_padding_8dp"
                            android:layout_marginEnd="@dimen/margin_padding_8dp"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginStart="@dimen/margin_padding_12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:textSize="@dimen/text_size_13sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:textColor="@color/black"
                            android:fontFamily="@font/inter_semibold"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="89dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_height="43dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:src="@drawable/image_tour_firma" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:id="@+id/view4"
                        android:layout_marginStart="@dimen/margin_padding_4dp"
                        android:backgroundTint="#F6F6F6"
                        android:background="@drawable/background_grey"
                        android:layout_height="80dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dimens_0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/hotels"
                            android:layout_marginEnd="@dimen/margin_padding_8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginStart="@dimen/margin_padding_12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:elevation="@dimen/margin_padding_8dp"
                            android:textSize="@dimen/text_size_13sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/inter_semibold"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="115dp"
                            android:layout_height="wrap_content"
                            android:elevation="@dimen/margin_padding_8dp"
                            android:src="@drawable/hotel_png"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_marginTop="@dimen/margin_padding_8dp"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/margin_padding_16"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:id="@+id/view5"
                        android:layout_marginEnd="@dimen/margin_padding_4dp"
                        android:backgroundTint="#F6F6F6"
                        android:background="@drawable/background_grey"
                        android:layout_height="80dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dimens_0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/carRent"
                            android:elevation="@dimen/margin_padding_8dp"
                            android:layout_marginEnd="@dimen/margin_padding_8dp"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginStart="@dimen/margin_padding_12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:textSize="@dimen/text_size_13sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:textColor="@color/black"
                            android:fontFamily="@font/inter_semibold"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_height="50dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:src="@drawable/ic_tour_avto_procat" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:id="@+id/view6"
                        android:layout_marginStart="@dimen/margin_padding_4dp"
                        android:backgroundTint="#F6F6F6"
                        android:background="@drawable/background_grey"
                        android:layout_height="80dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/dimens_0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/hotels"
                            android:layout_marginEnd="@dimen/margin_padding_8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginStart="@dimen/margin_padding_12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:elevation="@dimen/margin_padding_8dp"
                            android:textSize="@dimen/text_size_13sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/inter_semibold"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/dimens_18dp"
                            android:layout_height="@dimen/margin_padding_24dp"
                            android:elevation="@dimen/margin_padding_8dp"
                            android:src="@drawable/ic_saved"
                            android:layout_marginBottom="@dimen/margin_padding_16"
                            android:layout_marginEnd="@dimen/margin_padding_16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <RelativeLayout
                    android:layout_marginTop="@dimen/margin_padding_24dp"
                    android:layout_width="wrap_content"
                    android:id="@+id/explore"
                    android:layout_marginHorizontal="@dimen/margin_padding_16"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/discover_the_world"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_18sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:drawableEnd="@drawable/ic_arrow_right"
                        android:drawablePadding="@dimen/margin_padding_8dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/alll"
                        android:drawableTint="@color/green"
                        android:textColor="@color/green"
                        android:textSize="@dimen/text_size_15sp" />
                </RelativeLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:paddingBottom="@dimen/margin_padding_24dp"
                    android:layout_marginTop="@dimen/margin_padding_12dp"
                    android:layout_width="match_parent"
                    android:paddingStart="@dimen/margin_padding_16"
                    android:paddingEnd="7dp"
                    android:clipToPadding="false"
                    android:layout_height="wrap_content"
                    android:id="@+id/recyclerViewDiscover"/>


            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <include layout="@layout/loader_lottie"
        android:id="@+id/loader"/>






</androidx.coordinatorlayout.widget.CoordinatorLayout>