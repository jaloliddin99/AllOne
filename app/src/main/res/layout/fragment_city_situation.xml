<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:elevation="@dimen/margin_padding_4dp"
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/backToHome"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_centerVertical="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter_medium"
            android:text="@string/situation"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp" />

    </RelativeLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:layout_marginTop="@dimen/margin_padding_24dp"
            android:backgroundTint="@color/grey"
            android:elevation="0dp"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dark_grey"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_padding_16"
                android:fontFamily="@font/inter_medium"
                android:text="@string/enter_home_address"
                android:drawableStart="@drawable/ic_img3"
                android:drawablePadding="@dimen/margin_padding_12dp"
                android:drawableEnd="@drawable/ic_img2"
                android:textColor="@color/black"
                android:textSize="15sp" />


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/workplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:backgroundTint="@color/grey"
            android:elevation="0dp"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dark_grey"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_padding_16"
                android:fontFamily="@font/inter_medium"
                android:drawableStart="@drawable/ic_img1"
                android:text="@string/enter_workplace"
                android:drawablePadding="@dimen/margin_padding_12dp"
                android:drawableEnd="@drawable/ic_img2"
                android:textColor="@color/black"
                android:textSize="15sp" />


        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:id="@+id/locationNotesRecycler"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/addLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_padding_16"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:backgroundTint="@color/grey"
            android:elevation="0dp"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dark_grey"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_padding_16"
                android:fontFamily="@font/inter_medium"
                android:text="@string/add_additional_place"
                android:drawableEnd="@drawable/ic_img2"
                android:textColor="@color/black"
                android:textSize="15sp" />


        </com.google.android.material.card.MaterialCardView>


    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/margin_padding_16"
        android:layout_marginEnd="@dimen/margin_padding_16"
        android:background="@drawable/background_white_corner_12"
        android:backgroundTint="@color/green"
        android:padding="@dimen/margin_padding_16dp"
        android:text="@string/back"
        android:layout_marginBottom="@dimen/margin_padding_24dp"
        android:textAppearance="@style/boldStyleLight"
        android:textSize="@dimen/text_size_18sp" />

</RelativeLayout>