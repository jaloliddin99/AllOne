<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.profile.settings.AboutProgramFragment">

    <RelativeLayout
        android:elevation="@dimen/margin_padding_4dp"
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/backToHome"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_centerVertical="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="О приложении"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp"
            android:fontFamily="@font/inter_medium"
            android:layout_centerInParent="true"/>

    </RelativeLayout>


    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_bigger_logo"
        android:layout_marginTop="60dp"
        app:tint="@color/green"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="AllOne App V1.0.1 (1)"
        android:layout_marginTop="@dimen/margin_padding_4dp"
        android:textSize="@dimen/text_size_15sp"
        android:fontFamily="@font/inter_regular"/>


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        app:cardElevation="0dp"
        android:elevation="0dp"
        android:id="@+id/howToGetBonus"
        android:backgroundTint="@color/grey"
        android:layout_marginStart="@dimen/margin_padding_16dp"
        android:layout_marginEnd="@dimen/margin_padding_16dp"
        app:cardCornerRadius="@dimen/margin_padding_12dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="@dimen/margin_padding_24dp"
            android:layout_marginEnd="@dimen/margin_padding_24dp"
            android:drawableEnd="@drawable/ic_arrow_right_green"
            android:drawableStart="@drawable/ic_paper"
            android:drawablePadding="@dimen/margin_padding_12dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_regular"
            android:text="@string/License_agreement" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        app:cardElevation="0dp"
        android:elevation="0dp"
        android:backgroundTint="@color/grey"
        android:layout_marginStart="@dimen/margin_padding_16dp"
        android:layout_marginEnd="@dimen/margin_padding_16dp"
        app:cardCornerRadius="@dimen/margin_padding_12dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="@dimen/margin_padding_24dp"
            android:layout_marginStart="@dimen/margin_padding_24dp"
            android:drawableEnd="@drawable/ic_arrow_right_green"
            android:drawableStart="@drawable/ic_paper"
            android:drawablePadding="@dimen/margin_padding_12dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_regular"
            android:text="@string/PrivacyPolicy" />
    </com.google.android.material.card.MaterialCardView>



    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/goBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_16dp"
        android:layout_marginBottom="@dimen/margin_padding_24dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/margin_padding_16"
        android:background="@drawable/background_white_corner_12"
        android:backgroundTint="@color/green"
        android:padding="@dimen/margin_padding_16dp"
        android:text="@string/back"
        android:textAppearance="@style/boldStyleLight"
        android:textSize="@dimen/text_size_18sp" />



</androidx.appcompat.widget.LinearLayoutCompat>