<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:context=".fragments.medTurism.doctorView.FragmentDoctorView"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height_56dp"
            android:id="@+id/toolbar"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backToHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_padding_12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/margin_padding_12dp"
                android:src="@drawable/ic_arrow_left" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/margin_padding_12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/margin_padding_12dp"
                android:src="@drawable/ic_savee" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nestedScrollView"
            android:scrollbars="none">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/margin_padding_12dp"
                    android:layout_marginHorizontal="@dimen/margin_padding_16"
                    android:layout_height="wrap_content">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        app:cardCornerRadius="38dp"
                        app:rippleColor="@android:color/transparent"
                        app:cardElevation="@dimen/dimens_0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="match_parent"
                            android:scaleType="centerCrop"
                            android:layout_height="match_parent"
                            android:id="@+id/poster"/>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/icon_size_20dp"
                        android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/name"
                            android:textSize="@dimen/text_size_20sp"
                            android:textColor="@color/black"
                            android:lineSpacingExtra="@dimen/margin_padding_4dp"
                            android:fontFamily="@font/inter_semibold"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#119E46"
                            android:id="@+id/type"
                            android:textSize="@dimen/text_size_15sp"
                            android:fontFamily="@font/inter_medium"
                            android:layout_marginTop="@dimen/margin_padding_4dp"/>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/margin_padding_16"
                    android:layout_marginTop="@dimen/icon_size_20dp"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="@dimen/dimens_0dp"
                        android:id="@+id/rate"
                        android:layout_marginEnd="@dimen/margin_padding_4dp"
                        android:layout_height="70dp"
                        android:background="@drawable/background_white_corner_12"
                        android:backgroundTint="#F6F6F6"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/rating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_star_green"
                                    android:drawablePadding="@dimen/margin_padding_8dp"
                                    android:drawableTint="@color/yellow"
                                    android:fontFamily="@font/inter_bold"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/text_size_20sp" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/review_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/dimens_6dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:textColor="#CC272727"
                                    android:textSize="@dimen/text_size_15sp" />
                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/dimens_10dp"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/estimate"
                                android:textColor="#E6272727"
                                android:textSize="@dimen/text_size_13sp" />
                        </androidx.appcompat.widget.LinearLayoutCompat>


                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="@dimen/dimens_0dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="@dimen/margin_padding_4dp"
                        android:background="@drawable/background_white_corner_12"
                        android:backgroundTint="#F6F6F6"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/dimens_18dp"
                                android:layout_height="@dimen/dimens_18dp"
                                android:src="@drawable/ic_call"
                                android:layout_gravity="center"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/dimens_10dp"
                                android:textColor="#E6272727"
                                android:textSize="@dimen/text_size_13sp"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/call"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </RelativeLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="@dimen/margin_padding_16">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_padding_24dp"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/icon_size_20dp"
                            android:layout_height="@dimen/icon_size_20dp"
                            android:src="@drawable/ic_location"
                            android:layout_marginStart="@dimen/margin_padding_4dp"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_padding_16"
                            android:layout_marginEnd="@dimen/margin_padding_8dp"
                            android:drawableTint="@color/green"
                            android:textSize="@dimen/text_size_15sp"
                            android:id="@+id/addr"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/black"
                            android:paddingEnd="@dimen/margin_padding_12dp"
                            android:drawableEnd="@drawable/ic_arrow_right" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:background="#1A272727"
                        android:layout_marginVertical="@dimen/margin_padding_12dp"/>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/icon_size_20dp"
                            android:layout_height="@dimen/icon_size_20dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_call"
                            android:layout_marginStart="@dimen/margin_padding_4dp"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/recyclerViewPhones"
                            android:overScrollMode="never"
                            android:clipToPadding="false"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_padding_16"
                            android:drawableTint="@color/green"
                            android:textSize="@dimen/text_size_15sp"
                            android:id="@+id/phone_number"
                            android:textColor="@color/black"
                            android:fontFamily="@font/inter_medium"/>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:background="#1A272727"
                        android:layout_marginVertical="@dimen/margin_padding_12dp"/>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/icon_size_20dp"
                            android:layout_height="@dimen/icon_size_20dp"
                            android:src="@drawable/ic_telegram"
                            android:layout_marginStart="@dimen/margin_padding_4dp"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:layout_marginStart="@dimen/margin_padding_16"
                            android:drawableTint="@color/green"
                            android:textSize="@dimen/text_size_15sp"
                            android:id="@+id/telegram"
                            android:textColor="@color/black"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:background="#1A272727"
                        android:layout_marginVertical="@dimen/margin_padding_12dp"/>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/icon_size_20dp"
                            android:layout_height="@dimen/icon_size_20dp"
                            android:src="@drawable/ic_time"
                            android:layout_marginStart="@dimen/margin_padding_4dp"/>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_padding_16"
                            android:orientation="vertical">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableTint="@color/green"
                                android:textSize="@dimen/text_size_15sp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/work_hours"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableTint="@color/green"
                                android:textSize="@dimen/text_size_15sp"
                                android:textColor="@color/black"
                                android:layout_marginTop="@dimen/margin_padding_4dp"
                                android:id="@+id/work_time"
                                android:fontFamily="@font/inter_regular"/>

                        </androidx.appcompat.widget.LinearLayoutCompat>


                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clinic"
                        android:layout_marginTop="@dimen/margin_padding_24dp"
                        android:textSize="@dimen/text_size_18sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/black"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/recyclerView"
                        android:layout_marginTop="@dimen/margin_padding_8dp"
                        android:overScrollMode="never"
                        android:clipToPadding="false"/>


                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clinic"
                        android:layout_marginTop="15dp"
                        android:textSize="@dimen/text_size_18sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/black"/>


                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lorem_ipsum"
                        android:id="@+id/description"
                        android:layout_marginTop="@dimen/margin_padding_8dp"
                        android:textSize="@dimen/text_size_15sp"
                        android:paddingBottom="@dimen/margin_padding_24dp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingExtra="@dimen/margin_padding_4dp"
                        android:textColor="@color/black"/>



                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>


    </androidx.appcompat.widget.LinearLayoutCompat>

    <include layout="@layout/loader_lottie"
        android:id="@+id/loader"/>




</androidx.coordinatorlayout.widget.CoordinatorLayout>