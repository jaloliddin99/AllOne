<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="@dimen/margin_padding_12dp"
    android:layout_height="wrap_content">



    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="@dimen/dimens_0dp"
        android:layout_height="wrap_content"
        android:text="@string/lorem_ipsum"
        android:id="@+id/name"
        android:textSize="@dimen/text_size_15sp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/black"
        android:layout_marginEnd="@dimen/margin_padding_12dp"
        android:lineSpacingExtra="@dimen/margin_padding_4dp"
        app:layout_constraintEnd_toStartOf="@id/price"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/margin_padding_12dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="@dimen/dimens_0dp"
        android:layout_height="wrap_content"
        android:textColor="#119E46"
        android:textSize="@dimen/text_size_15sp"
        android:fontFamily="@font/inter_medium"
        android:text="18000.00"
        android:id="@+id/price"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        android:background="#1A272727"/>


</androidx.constraintlayout.widget.ConstraintLayout>