<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_corner_12"
    android:padding="@dimen/margin_padding_8dp"
    android:layout_marginBottom="9dp"
    android:backgroundTint="@color/grey"
    android:layout_height="wrap_content">



    <com.google.android.material.card.MaterialCardView
        android:layout_width="80dp"
        android:id="@+id/cardView"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardCornerRadius="@dimen/margin_padding_8dp"
        app:cardElevation="@dimen/dimens_0dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/poster"
            android:scaleType="centerInside"/>

    </com.google.android.material.card.MaterialCardView>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="@dimen/dimens_0dp"
        app:layout_constraintStart_toEndOf="@id/cardView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/call"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_padding_12dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:maxLines="1"
            android:id="@+id/name"
            android:ellipsize="end"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_15sp"
            android:fontFamily="@font/inter_semibold"/>


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingVertical="@dimen/dimen_2dp"
            android:id="@+id/price"
            android:paddingHorizontal="@dimen/margin_padding_4dp"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_medium"
            android:backgroundTint="@color/dark_grey"
            android:textColor="@color/black"
            android:background="@drawable/drawable_4dp_corner"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:drawablePadding="6dp"
            android:id="@+id/phone_number"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp"
            android:fontFamily="@font/inter_bold"/>



    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="40dp"
        android:src="@drawable/ic_btn_call"
        android:background="?android:selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="@dimen/margin_padding_4dp"
        android:id="@+id/call"
        android:layout_gravity="center_vertical"/>




</androidx.constraintlayout.widget.ConstraintLayout>