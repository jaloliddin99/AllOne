<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.taxiCity.main.FragmentCitySelectLocation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:elevation="@dimen/margin_padding_8dp"
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content"
            android:id="@+id/backToHome"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_centerVertical="true"
            android:focusable="true" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/shimmerLayout"
                android:layout_gravity="center_horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yourAddress"
                    android:textSize="@dimen/text_size_12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/inter_medium"
                    android:id="@+id/yourAddress"/>
            </com.facebook.shimmer.ShimmerFrameLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:singleLine="true"
                android:id="@+id/yourAddress1"
                android:ellipsize="end"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#66000000"
        android:id="@+id/blur"
        android:elevation="@dimen/margin_padding_4dp"/>
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>


    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_dest"
        android:id="@+id/mapIcon"
        android:layout_gravity="center"/>



    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheetNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/margin_padding_24dp"
        android:animateLayoutChanges="true"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="280dp"
       >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="vertical">
           <androidx.constraintlayout.widget.ConstraintLayout
               android:layout_width="match_parent"
               android:clipToPadding="false"
               android:layout_marginBottom="@dimen/margin_padding_16"
               android:layout_height="wrap_content">

               <androidx.appcompat.widget.AppCompatTextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/on_the_map"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintStart_toStartOf="parent"
                   android:textColor="@color/white"
                   android:alpha="0"
                   android:id="@+id/txtFromCard"
                   app:layout_constraintBottom_toBottomOf="parent"
                   android:textSize="@dimen/text_size_15sp"
                   android:fontFamily="@font/inter_regular" />

               <androidx.appcompat.widget.AppCompatImageView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintBottom_toBottomOf="parent"
                   app:layout_constraintTop_toTopOf="parent"
                   android:src="@drawable/ic_btn_loc"

                   android:layout_marginEnd="@dimen/margin_padding_16"
                   android:id="@+id/requestFocus"/>
           </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_padding_16"
                android:background="@drawable/white_background_top_corner"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_padding_12dp"
                    android:layout_marginBottom="9dp"
                    android:src="@drawable/ic_line" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_grey_rounded"
                    android:paddingStart="@dimen/margin_padding_16"
                    android:paddingVertical="@dimen/margin_padding_16"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_padding_8dp"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/margin_padding_8dp"
                        android:paddingBottom="@dimen/margin_padding_8dp"
                        android:src="@drawable/ic_group_image" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="50"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/start_destination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_padding_16"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:selectAllOnFocus="true"
                            android:background="@null"
                            android:fontFamily="@font/inter_medium"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="15sp" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/margin_padding_12dp"
                            android:layout_marginBottom="@dimen/margin_padding_12dp"
                            android:background="@color/dark_grey" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/end_destination"
                                app:layout_constraintStart_toStartOf="parent"
                                android:layout_width="@dimen/dimens_0dp"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:ellipsize="end"
                                app:layout_constraintEnd_toStartOf="@id/selectFromMap"
                                android:selectAllOnFocus="true"
                                android:fontFamily="@font/inter_medium"
                                android:hint="@string/where_going"
                                android:maxLines="1"
                                android:layout_marginEnd="@dimen/margin_padding_16"
                                android:singleLine="true"
                                android:imeOptions="actionDone"
                                android:textColor="@color/black"
                                android:textSize="15sp" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:id="@+id/selectFromMap"
                                android:textColor="@color/black"
                                app:layout_constraintTop_toTopOf="parent"
                                android:visibility="gone"
                                android:fontFamily="@font/inter_semibold"
                                android:textSize="@dimen/text_size_15sp"
                                android:layout_marginEnd="@dimen/margin_padding_16"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_height="wrap_content"
                                android:text="@string/on_the_map"/>



                        </androidx.constraintlayout.widget.ConstraintLayout>



                    </androidx.appcompat.widget.LinearLayoutCompat>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_48dp"
                    android:background="@drawable/bg_grey_rounded"
                    android:layout_marginTop="@dimen/margin_padding_8dp"
                    android:text="@string/saved"
                    android:id="@+id/savedLocations"
                    android:gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_13sp"
                    android:fontFamily="@font/inter_regular"
                    android:paddingStart="@dimen/dimens_18dp"
                    android:drawableEnd="@drawable/ic_arrow_right_green"
                    android:paddingEnd="@dimen/dimens_18dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:id="@+id/recyclerView"/>



            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/bottomSHeet"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:elevation="@dimen/margin_padding_24dp"
        android:background="@color/white">



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/goToTariffs"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height_56dp"
            android:layout_marginStart="@dimen/margin_padding_16dp"
            android:layout_marginEnd="@dimen/margin_padding_16dp"
            android:layout_marginBottom="@dimen/margin_padding_16"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green"
            android:elevation="0dp"
            android:fontFamily="@font/inter_semibold"
            android:padding="@dimen/margin_padding_16dp"
            android:text="@string/goToTariff"
            android:textAppearance="@style/boldStyleLight"
            android:textSize="@dimen/text_size_18sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.coordinatorlayout.widget.CoordinatorLayout>