<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.profile.BonusFragment">
    <RelativeLayout
        android:elevation="@dimen/margin_padding_4dp"
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/backToHome"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_centerVertical="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bonus_card"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp"
            android:fontFamily="@font/inter_medium"
            android:layout_centerInParent="true"/>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/green"
            android:layout_marginStart="@dimen/margin_padding_16dp"
            android:layout_marginEnd="@dimen/margin_padding_16dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:cardElevation="0dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="4"/>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_weight="6">
                        <FrameLayout
                            android:layout_marginStart="32dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_first_wave"/>
                        <FrameLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_second_wave"/>
                    </RelativeLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_padding_16dp"
                    android:layout_marginTop="@dimen/margin_padding_12dp"
                    android:layout_marginEnd="@dimen/margin_padding_16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Бонусные баллы:"
                        android:layout_weight="2"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_18sp"
                        android:fontFamily="@font/inter_medium" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/user_id"
                        android:textColor="@color/white"
                        android:textAlignment="textEnd" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_padding_16dp"
                    android:layout_marginTop="@dimen/margin_padding_12dp"
                    android:layout_marginEnd="@dimen/margin_padding_16dp"
                    android:layout_marginBottom="@dimen/margin_padding_16dp"
                    android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="34 000"
                            android:textColor="@color/white"
                            android:fontFamily="@font/inter_bold"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_size_24sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sum"
                            android:textSize="@dimen/text_size_18sp"
                            android:layout_marginStart="@dimen/margin_padding_4dp"
                            android:textColor="@color/white" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/how_to_accept"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_medium"
                    android:drawablePadding="@dimen/margin_padding_12dp"
                    android:drawableRight="@drawable/ic_arrow_right_white"
                    android:layout_marginStart="@dimen/margin_padding_16dp"
                    android:layout_marginBottom="@dimen/margin_padding_24dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            app:cardElevation="0dp"
            android:elevation="0dp"
            android:id="@+id/howToGetBonus"
            android:backgroundTint="@color/grey"
            android:layout_marginStart="@dimen/margin_padding_16dp"
            android:layout_marginEnd="@dimen/margin_padding_16dp"
            app:cardCornerRadius="@dimen/margin_padding_12dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="@dimen/margin_padding_24dp"
                android:layout_marginEnd="@dimen/margin_padding_24dp"
                android:drawableEnd="@drawable/ic_arrow_right_green"
                android:drawableStart="@drawable/ic_time_green"
                android:drawablePadding="@dimen/margin_padding_12dp"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:fontFamily="@font/inter_medium"
                android:text="@string/get_bonus" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            app:cardElevation="0dp"
            android:elevation="0dp"
            android:backgroundTint="@color/grey"
            android:layout_marginStart="@dimen/margin_padding_16dp"
            android:layout_marginEnd="@dimen/margin_padding_16dp"
            app:cardCornerRadius="@dimen/margin_padding_12dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginEnd="@dimen/margin_padding_24dp"
                android:layout_marginStart="@dimen/margin_padding_24dp"
                android:drawableEnd="@drawable/ic_arrow_right_green"
                android:drawableStart="@drawable/ic_time_green"
                android:drawablePadding="@dimen/margin_padding_12dp"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:fontFamily="@font/inter_medium"
                android:text="Как использовать" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


</RelativeLayout>