<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".fragments.profile.settings.changeData.ChangeDataFragment">

    <RelativeLayout
        android:elevation="@dimen/margin_padding_4dp"
        android:layout_width="match_parent"
        android:id="@+id/toolbar"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/backToHome"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:padding="@dimen/margin_padding_12dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_centerVertical="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_profile"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20sp"
            android:fontFamily="@font/inter_medium"
            android:layout_centerInParent="true"/>

    </RelativeLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_padding_16dp"
            android:paddingEnd="@dimen/margin_padding_16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_24dp"
                android:fontFamily="@font/inter_bold"
                android:text="Ф.И.О"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_16dp"
                android:id="@+id/name"
                android:imeOptions="actionDone"
                android:background="@drawable/bg_edit_text"
                android:drawableEnd="@drawable/ic_user"
                android:drawableTint="@color/black"
                android:fontFamily="@font/inter_regular"
                android:paddingStart="@dimen/margin_padding_24dp"
                android:paddingTop="@dimen/margin_padding_16dp"
                android:paddingEnd="@dimen/margin_padding_24dp"
                android:paddingBottom="@dimen/margin_padding_16dp"
                android:text="Abdumalik Izzatov"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_24dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/your_gender"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/selectGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_16dp"
                android:background="@drawable/bg_edit_text"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:drawableTint="@color/black"
                android:fontFamily="@font/inter_regular"
                android:paddingStart="@dimen/margin_padding_24dp"
                android:paddingTop="@dimen/margin_padding_16dp"
                android:paddingEnd="@dimen/margin_padding_24dp"
                android:paddingBottom="@dimen/margin_padding_16dp"
                android:text="Мужской"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_24dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/your_birthday"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/selectDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_16dp"
                android:background="@drawable/bg_edit_text"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:drawableTint="@color/black"
                android:fontFamily="@font/inter_regular"
                android:paddingStart="@dimen/margin_padding_24dp"
                android:paddingTop="@dimen/margin_padding_16dp"
                android:paddingEnd="@dimen/margin_padding_24dp"
                android:paddingBottom="@dimen/margin_padding_16dp"
                android:text="11.07.2001"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/margin_padding_16dp"
        android:layout_marginTop="@dimen/margin_padding_8dp"
        android:layout_marginEnd="@dimen/margin_padding_16dp"
        android:layout_marginBottom="@dimen/margin_padding_24dp"
        android:background="@drawable/background_green_corner_12"
        android:elevation="0dp"
        android:fontFamily="@font/inter_bold"
        android:padding="@dimen/margin_padding_16dp"
        android:text="@string/send"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_14sp"
        app:elevation="0dp" />


</androidx.appcompat.widget.LinearLayoutCompat>