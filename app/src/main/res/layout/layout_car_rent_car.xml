<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_marginTop="@dimen/dimen_32dp"
        android:layout_width="wrap_content"
        android:id="@+id/explore"
        android:layout_marginHorizontal="@dimen/margin_padding_16"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:id="@+id/name"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_18sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="@dimen/margin_padding_8dp"
            android:fontFamily="@font/inter_medium"
            android:text="@string/alll"
            android:drawableTint="@color/green"
            android:textColor="@color/green"
            android:textSize="@dimen/text_size_15sp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        android:paddingStart="@dimen/margin_padding_16"
        android:paddingEnd="7dp"
        android:id="@+id/recyclerView"
        android:clipToPadding="false"/>




</androidx.appcompat.widget.LinearLayoutCompat>