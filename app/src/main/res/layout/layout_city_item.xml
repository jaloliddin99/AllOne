<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/margin_padding_16"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/icon_size_20dp"
            android:layout_height="@dimen/icon_size_20dp"
            android:padding="5dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_circle_green"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Абдуллы Кадыри 33"
            android:layout_gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/margin_padding_8dp"
            android:textSize="@dimen/text_size_15sp"
            android:textColor="@color/black"
            android:id="@+id/station"
            android:fontFamily="@font/inter_regular"
            android:layout_weight="9"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:src="@drawable/ic_three_equals"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:background="?android:selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/delete_station"
            android:layout_weight="1"
            android:src="@drawable/ic_delete"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.legacy.widget.Space
            android:layout_width="@dimen/icon_size_20dp"
            android:layout_height="@dimen/dimens_0dp"/>

        <View
            android:layout_width="0dp"
            android:layout_weight="11"
            android:layout_marginStart="@dimen/margin_padding_8dp"
            android:layout_height="1dp"
            android:background="@color/dark_grey"
            android:layout_marginTop="@dimen/margin_padding_16"/>
    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>