<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_grey"
    >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">

        <TextView
            android:paddingTop="@dimen/margin_padding_12dp"
            android:paddingBottom="@dimen/margin_padding_12dp"
            android:paddingStart="18dp"
            android:background="@drawable/text_border"
            android:paddingEnd="20dp"
            android:textSize="@dimen/text_size_15sp"
            android:fontFamily="@font/inter_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/chose_gender"
            app:drawableEndCompat="@drawable/ic_arrow_down" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/male"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:text="@string/man"
                android:buttonTint="@color/green"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/margin_padding_12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/text_size_18sp"
                android:layout_marginEnd="20dp"
                android:background="@color/dark_grey" />

            <RadioButton
                android:id="@+id/female"
                android:buttonTint="@color/green"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:text="@string/female"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/margin_padding_12dp" />

        </RadioGroup>
    </androidx.appcompat.widget.LinearLayoutCompat>


</RelativeLayout>