<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:orientation="vertical"
    tools:context=".fragments.login.SplashFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        android:layout_height="@dimen/item_height_56dp"
        android:layout_marginTop="@dimen/dimen_32dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_main_logo" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:id="@+id/linearLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/margin_padding_24dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/chooseLanguage"
            android:textAppearance="@style/boldStyleLight"
            android:textSize="@dimen/text_size_18sp" />


        <LinearLayout
            android:layout_marginTop="@dimen/margin_padding_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/uzbLan"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/margin_padding_16"
                android:elevation="@dimen/dimens_0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_white_corner_12"
                android:drawableStart="@drawable/ic_uzb_flag"
                android:padding="@dimen/margin_padding_16"
                android:text="O'zbekcha"
                android:textAppearance="@style/mediumStyle"
                android:textSize="@dimen/text_size_18sp" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:orientation="horizontal">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/rusLan"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:elevation="@dimen/dimens_0dp"
                android:layout_marginHorizontal="@dimen/margin_padding_16"
                android:layout_height="wrap_content"
                android:background="@drawable/background_white_corner_12"
                android:drawableStart="@drawable/ic_russian_flag"
                android:padding="@dimen/margin_padding_16"
                android:textAlignment="center"
                android:text="@string/russian"
                android:textAppearance="@style/mediumStyle"
                android:textSize="@dimen/text_size_18sp" />



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:orientation="horizontal">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/enLan"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:layout_marginHorizontal="@dimen/margin_padding_16"
                android:layout_height="wrap_content"
                android:background="@drawable/background_white_corner_12"
                android:drawableStart="@drawable/ic_english_flag"
                android:padding="@dimen/margin_padding_16"
                android:textAlignment="center"
                android:text="@string/english"
                android:elevation="@dimen/dimens_0dp"
                android:textAppearance="@style/mediumStyle"
                android:textSize="@dimen/text_size_18sp" />



        </LinearLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.constraintlayout.widget.ConstraintLayout>