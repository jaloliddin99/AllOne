<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/white_background_top_corner"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_order_cancelled"
        android:layout_marginTop="@dimen/margin_padding_24dp"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/text_size_20sp"
        android:layout_marginTop="30dp"
        android:layout_gravity="center"
        android:textAlignment="center"
        android:textSize="@dimen/text_size_18sp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/black"
        android:text="@string/order_cancelled_sorry"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/text_size_20sp"
        android:layout_marginTop="@dimen/margin_padding_8dp"
        android:layout_gravity="center"
        android:textAlignment="center"
        android:textSize="@dimen/text_size_15sp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/black"
        android:text="@string/please_try_again"/>


    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:id="@+id/orderAgain"
        android:layout_height="@dimen/item_height_56dp"
        android:insetBottom="@dimen/dimens_0dp"
        android:insetTop="@dimen/dimens_0dp"
        android:layout_marginHorizontal="@dimen/margin_padding_16"
        android:layout_marginTop="@dimen/margin_padding_24dp"
        android:layout_marginBottom="@dimen/dimen_32dp"
        app:cornerRadius="@dimen/margin_padding_12dp"
        android:text="@string/order_again"
        android:fontFamily="@font/inter_bold"
        android:textAllCaps="false"
        android:textSize="@dimen/text_size_15sp"/>


</androidx.appcompat.widget.LinearLayoutCompat>