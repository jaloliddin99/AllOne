<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_padding_16"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:layout_marginBottom="9dp"
            android:src="@drawable/ic_line" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_4dp"
            android:text="@string/chooseType"
            android:textSize="@dimen/text_size_15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_semibold"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:id="@+id/city"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_city_first"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/icon_size_20dp"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inside_city"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="@dimen/margin_padding_16"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tint="@color/white"
                android:src="@drawable/ic_arrow_right"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/region"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_region_first"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/icon_size_20dp"
                android:layout_marginEnd="@dimen/margin_padding_16"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inter_regional"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="@dimen/margin_padding_16"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tint="@color/white"
                android:src="@drawable/ic_arrow_right"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/international"
            android:layout_marginBottom="@dimen/margin_padding_24dp"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_inter_first"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/icon_size_20dp"
                android:layout_marginEnd="@dimen/margin_padding_16"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inter_national"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="@dimen/margin_padding_16"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tint="@color/white"
                android:src="@drawable/ic_arrow_right"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>