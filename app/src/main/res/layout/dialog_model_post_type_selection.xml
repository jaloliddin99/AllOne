<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_padding_16"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:layout_marginBottom="9dp"
            android:src="@drawable/ic_line" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_4dp"
            android:text="@string/chooseType"
            android:textSize="@dimen/text_size_15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_semibold"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_12dp"
            android:id="@+id/city"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Доставка  внутри города"
                android:textColor="@color/white"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="@dimen/margin_padding_16"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_parcel_vinturi"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/region"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Межобластная доставка"
                android:textColor="@color/white"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="@dimen/margin_padding_16"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_parcel_interna"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/international"
            android:layout_marginBottom="@dimen/margin_padding_24dp"
            android:layout_marginTop="@dimen/margin_padding_8dp"
            android:background="@drawable/background_white_corner_12"
            android:backgroundTint="@color/green">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Международная доставка"
                android:textColor="@color/white"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="@dimen/margin_padding_16"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_parcel_worldwide"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_padding_16"/>

        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>