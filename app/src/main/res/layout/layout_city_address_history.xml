<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout"
    android:layout_marginTop="@dimen/margin_padding_12dp"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/icon_size_20dp"
            android:layout_height="@dimen/icon_size_20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/iconStart"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/margin_padding_8dp"
            android:src="@drawable/ic_home_icon"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/margin_padding_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iconEnd"
            app:layout_constraintStart_toEndOf="@id/iconStart"
            android:layout_marginStart="@dimen/dimen_14dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textSize="@dimen/text_size_15sp"
                android:id="@+id/name"
                android:textColor="@color/black"
                android:text="Мой дом"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:id="@+id/address"
                android:maxLines="1"
                android:text="Чиланазар-15, 86-6, 8 дом,eifeofisofiseofijs Ташкент, Узбек..."/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/icon_size_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/iconEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="@dimen/icon_size_20dp"
            android:src="@drawable/ic_edit_pen"
            android:layout_gravity="center_vertical"
            app:tint="@color/green"
            android:layout_marginEnd="@dimen/margin_padding_12dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:background="@color/grey"
        android:layout_marginTop="@dimen/margin_padding_12dp"/>


</androidx.appcompat.widget.LinearLayoutCompat>