<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:elevation="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/margin_padding_8dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:strokeColor="@color/grey"
            app:strokeWidth="2dp"
            app:cardElevation="0dp"
            android:id="@+id/smallBox"
            app:rippleColor="@android:color/transparent"
            android:backgroundTint="@color/grey"
            android:layout_marginEnd="@dimen/margin_padding_4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/constraint1"
                android:paddingTop="@dimen/margin_padding_8dp"
                android:paddingStart="@dimen/margin_padding_12dp"
                tools:ignore="RtlSymmetry">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Небольшой"
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/baggage_type"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/baggage_type"
                    android:layout_marginTop="@dimen/margin_padding_4dp"
                    android:id="@+id/baggage_shape"
                    android:textSize="9dp"
                    android:text="30x30 \n500 рамм"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/baggage_shape"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="Бесплатно"
                    android:id="@+id/price"
                    android:layout_marginTop="@dimen/margin_padding_16dp"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/green"
                    android:layout_marginBottom="@dimen/margin_padding_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/att1"
                    android:elevation="@dimen/margin_padding_8dp"
                    android:src="@drawable/ic_attention"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="@dimen/margin_padding_4dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_first_box"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="@dimen/margin_padding_8dp"
                    app:layout_constraintTop_toTopOf="parent"/>





            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardElevation="0dp"
            android:backgroundTint="@color/grey"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            app:strokeColor="@color/grey"
            app:strokeWidth="2dp"
            android:id="@+id/middleBox"
            app:rippleColor="@android:color/transparent"
            android:layout_marginStart="@dimen/margin_padding_4dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/constraint2"
                android:paddingTop="@dimen/margin_padding_8dp"

                android:paddingStart="@dimen/margin_padding_12dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Средний"
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/baggage_type1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/baggage_type1"
                    android:layout_marginTop="@dimen/margin_padding_4dp"
                    android:id="@+id/baggage_shape1"
                    android:textSize="9dp"
                    android:text="40х40 \n5-Килограмм"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/baggage_shape1"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="Бесплатно"
                    android:id="@+id/price1"
                    android:textSize="15sp"
                    android:layout_marginTop="@dimen/margin_padding_16dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/green"
                    android:layout_marginBottom="@dimen/margin_padding_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_attention"
                    android:id="@+id/att2"
                    android:elevation="@dimen/margin_padding_8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="@dimen/margin_padding_4dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_third_box"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="@dimen/margin_padding_8dp"
                    app:layout_constraintTop_toTopOf="parent"/>





            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/margin_padding_8dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            android:id="@+id/largeBox"
            app:cardElevation="0dp"
            app:strokeColor="@color/grey"
            app:strokeWidth="2dp"
            app:rippleColor="@android:color/transparent"
            android:backgroundTint="@color/grey"
            android:layout_marginEnd="@dimen/margin_padding_4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/margin_padding_8dp"
                android:id="@+id/constraint3"
                android:paddingStart="@dimen/margin_padding_12dp"
                tools:ignore="RtlSymmetry">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Небольшой"
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/baggage_type2"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/baggage_type2"
                    android:layout_marginTop="@dimen/margin_padding_4dp"
                    android:id="@+id/baggage_shape2"
                    android:textSize="9dp"
                    android:text="30x30 \n10 kg"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/baggage_shape2"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="70 000 сум"
                    android:textSize="15sp"
                    android:id="@+id/price2"
                    android:layout_marginTop="@dimen/margin_padding_16dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/green"
                    android:layout_marginBottom="@dimen/margin_padding_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_attention"
                    android:id="@+id/att3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="@dimen/margin_padding_4dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="@dimen/margin_padding_8dp"
                    android:src="@drawable/ic_second_box"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="@dimen/margin_padding_8dp"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardElevation="0dp"
            app:rippleColor="@android:color/transparent"
            android:backgroundTint="@color/grey"
            app:strokeColor="@color/grey"
            app:strokeWidth="2dp"
            android:id="@+id/extraLargeBox"
            app:cardCornerRadius="@dimen/margin_padding_12dp"
            android:layout_marginStart="@dimen/margin_padding_4dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/margin_padding_8dp"
                android:id="@+id/constraint4"
                android:paddingStart="@dimen/margin_padding_12dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Занять место "
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/baggage_type3"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/baggage_type3"
                    android:layout_marginTop="@dimen/margin_padding_4dp"
                    android:id="@+id/baggage_shape3"
                    android:textSize="9dp"
                    android:text="40х40 \n50-Килограмм"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/baggage_shape3"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="100 000 сум"
                    android:textSize="15sp"
                    android:layout_marginTop="@dimen/margin_padding_16dp"
                    android:id="@+id/price3"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/green"
                    android:layout_marginBottom="@dimen/margin_padding_12dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="@dimen/margin_padding_4dp"
                    android:id="@+id/att4"
                    android:src="@drawable/ic_attention"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="@dimen/margin_padding_4dp"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    android:src="@drawable/ic_fourth_box"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>





            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>