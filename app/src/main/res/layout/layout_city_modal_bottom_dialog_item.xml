<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    app:cardCornerRadius="@dimen/margin_padding_8dp"
    android:layout_marginStart="@dimen/margin_padding_16"
    app:cardElevation="@dimen/margin_padding_4dp"
    app:rippleColor="@android:color/transparent"
    android:layout_marginTop="@dimen/margin_padding_4dp"
    android:layout_marginBottom="@dimen/margin_padding_8dp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/margin_padding_16"
        android:layout_marginVertical="@dimen/margin_padding_12dp"
        android:layout_height="wrap_content">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/car_image"
            android:layout_width="228dp"
            android:layout_height="100dp"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/moreInfo"
            android:layout_width="@dimen/dimen_32dp"
            android:padding="@dimen/dimens_6dp"
            android:background="?android:selectableItemBackground"
            android:clickable="true"

            android:focusable="true"
            android:layout_height="@dimen/dimen_32dp"
            app:tint="@color/dark_grey"

            android:src="@drawable/ic_attention"
            android:layout_alignParentEnd="true" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottomFrame"
            android:id="@+id/timeLeft"
            android:layout_alignParentEnd="true"
            android:fontFamily="@font/inter_medium"
            android:text="2 мин"
            android:textSize="@dimen/text_size_13sp" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bottomFrame"
            android:layout_below="@id/car_image">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tariff"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="@dimen/dimens_0dp"
                android:layout_height="wrap_content"
                android:text="Эконом"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintEnd_toStartOf="@id/price"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_18sp"
                app:fontFamily="@font/inter_bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/price"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:drawableStart="@drawable/ic_small_money"
                android:drawablePadding="@dimen/margin_padding_12dp"
                android:text="16000 сум"
                android:textColor="@color/green"
                android:textSize="@dimen/text_size_18sp"
                app:fontFamily="@font/inter_medium" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </RelativeLayout>





</com.google.android.material.card.MaterialCardView>