<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_white_corner_12"
    android:backgroundTint="#F6F6F6"
    android:layout_marginBottom="@dimen/margin_padding_16"
    android:padding="@dimen/margin_padding_12dp"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:id="@+id/card"
        app:layout_constraintTop_toTopOf="parent"
        app:cardElevation="@dimen/dimens_0dp"
        app:cardCornerRadius="@dimen/margin_padding_8dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:id="@+id/poster"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_drawable"
            android:id="@+id/company"
            android:includeFontPadding="false"
            android:layout_gravity="bottom"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_regular"
            android:layout_marginStart="@dimen/margin_padding_12dp"
            android:layout_marginBottom="@dimen/dimens_10dp"
            android:paddingHorizontal="@dimen/dimens_6dp"
            android:paddingVertical="3dp"/>



    </com.google.android.material.card.MaterialCardView>


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/card"
        android:layout_marginTop="@dimen/margin_padding_12dp"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="@dimen/text_size_18sp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/black"
        android:id="@+id/name"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_padding_4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/margin_padding_8dp"
        app:layout_constraintTop_toBottomOf="@id/name">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="@dimen/dimens_0dp"
            android:layout_height="wrap_content"
            android:id="@+id/addr"
            app:layout_constraintEnd_toStartOf="@id/price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:drawableStart="@drawable/ic_location_sma"
            android:textSize="@dimen/text_size_12sp"
            android:fontFamily="@font/inter_regular"
            android:drawablePadding="@dimen/dimens_6dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/price"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textSize="@dimen/text_size_15sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/dark_green"/>

    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>